/* ========== Basics & Theme ========== */
:root{
  --cream:#FFF8E7;
  --cream-2:#F9F3E5;
  --white:#ffffff;
  --ink:#2D2A26;
  --muted:#6F665E;
  --accent:#A67C52;
  --sage:#DDE3C2;
  --shadow: 0 10px 30px rgba(45,42,38,.12);
  --radius: 16px;
  --max-width:1140px;
}

*{box-sizing:border-box}
html,body{margin:0;padding:0;height:100%}
body{
  font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  color:var(--ink);
  background:
    radial-gradient(1200px 800px at 10% -10%, var(--white), transparent 40%),
    radial-gradient(1000px 600px at 100% 0%, var(--cream), transparent 50%),
    linear-gradient(180deg, var(--cream-2), var(--white) 30%, var(--cream));
}

.container{width:min(var(--max-width), 92%); margin-inline:auto}

/* ========== Header ========== */
.site-header{
  position:sticky; top:0; z-index:50;
  backdrop-filter: blur(8px);
  background: color-mix(in oklab, var(--cream) 70%, transparent);
  border-bottom:1px solid rgba(0,0,0,.06);
}
.header-inner{display:flex; align-items:center; justify-content:space-between; gap:18px; padding:14px 0}
.brand{display:flex; align-items:center; gap:12px}
.brand-mark{
  display:grid; place-items:center;
  width:44px; height:44px; border-radius:999px;
  background:linear-gradient(135deg, var(--accent), color-mix(in oklab, var(--accent) 60%, black));
  color:white; font-weight:700;
  box-shadow: var(--shadow);
}
.brand-text h1{font-family:"Playfair Display", serif; font-size:20px; margin:0}
.tagline{margin:3px 0 0; color:var(--muted); font-size:12px}

.nav{display:flex; gap:16px}
.nav a{color:var(--ink); text-decoration:none; font-weight:600; opacity:.85}
.nav a:hover{opacity:1; text-decoration:underline}

.actions{display:flex; align-items:center; gap:12px}
.search{display:flex; align-items:center; background:var(--white); border:1px solid rgba(0,0,0,.08); padding:6px; border-radius:999px; gap:6px; box-shadow: var(--shadow)}
.search input{border:none; outline:none; background:transparent; min-width:180px}
.btn{border:none; border-radius:12px; padding:10px 14px; font-weight:700; cursor:pointer; box-shadow: var(--shadow); transition:transform .15s ease}
.btn:hover{transform:translateY(-1px)}
.btn.primary{background:var(--accent); color:white}
.btn.outline{background:transparent; border:1px solid var(--accent); color:var(--accent)}
.btn.ghost{background:transparent}
.btn.cart{position:relative}
.badge{position:absolute; top:-8px; right:-8px; background:#E74C3C; color:white; font-size:12px; padding:2px 6px; border-radius:999px}

/* ========== HERO ========== */
.hero{position:relative; overflow:hidden; padding-bottom:30px}
.hero-inner{
  display:grid; grid-template-columns: 1.1fr 1fr; gap:36px; align-items:center; padding:54px 0 10px;
}
.hero-copy h2{font-family:"Playfair Display", serif; font-size:40px; line-height:1.15; margin:0 0 12px}
.hero-copy .accent{background:linear-gradient(90deg, var(--accent), #C8A27A); -webkit-background-clip:text; background-clip:text; color:transparent}
.lead{color:var(--muted); margin:0 0 18px}
.cta{display:flex; gap:12px; align-items:center}

.hero-showcase .stack{position:relative; perspective:1000px}
.hero-showcase .stack img{width:100%; border-radius:20px; box-shadow: var(--shadow); display:block}
.hero-showcase .stack img:nth-child(1){transform: rotate(-3deg)}
.hero-showcase .stack img:nth-child(2){position:absolute; left:0; bottom:-26px; transform: rotate(4deg)}
.hero-showcase .stack img:nth-child(3){position:absolute; left:0; bottom:-56px; transform: rotate(-1deg)}

.grain{position:absolute; inset:0; pointer-events:none; background-image: radial-gradient(rgba(0,0,0,.03) 1px, transparent 1px); background-size:4px 4px; opacity:.18}

/* ========== BEST & CATALOG ========== */
.section-title{font-family:"Playfair Display", serif; font-size:26px; margin:14px 0 18px}
.best-grid{display:grid; grid-template-columns: repeat(3, 1fr); gap:18px}
.best-card{background:var(--white); border:1px solid rgba(0,0,0,.08); border-radius:18px; overflow:hidden; box-shadow: var(--shadow); transform:translateY(10px); opacity:0}
.best-card img{width:100%; aspect-ratio: 4/3; object-fit:cover}
.best-card .info{padding:14px}
.best-card .price{font-weight:800; color:var(--accent); margin-top:6px}
.best-card .btn.add{margin-top:8px; width:100%}

.catalog{padding:30px 0 60px}
.catalog-head{display:flex; align-items:center; justify-content:space-between; gap:16px}
.filters{display:flex; flex-wrap:wrap; gap:10px}
.chip{padding:8px 12px; border-radius:999px; border:1px solid rgba(0,0,0,.12); background:var(--white); cursor:pointer; font-weight:600; box-shadow: var(--shadow)}
.chip.active, .chip:hover{background:var(--sage)}

.grid{margin-top:16px; display:grid; grid-template-columns: repeat(4, 1fr); gap:16px}
.card{background:var(--white); border:1px solid rgba(0,0,0,.08); border-radius:16px; overflow:hidden; box-shadow: var(--shadow); position:relative; transition:transform .2s ease}
.card:hover{transform: translateY(-6px); box-shadow: 0 20px 40px rgba(0,0,0,.14)}
.card img{width:100%; aspect-ratio: 3/4; object-fit:cover; display:block}
.card .content{padding:12px}
.card .title{font-weight:800}
.card .meta{color:var(--muted); font-size:14px; margin-top:4px}
.card .price{margin-top:8px; font-weight:800; color:var(--accent)}
.card .quick{position:absolute; top:10px; right:10px; border-radius:999px; padding:8px 10px; background: rgba(255,255,255,.9); border:1px solid rgba(0,0,0,.06)}

/* ========== ABOUT & FOOTER ========== */
.about{padding:60px 0; background:linear-gradient(180deg, var(--cream), var(--white))}
.about-inner{display:grid; grid-template-columns: 1fr 1fr; gap:24px; align-items:center}
.about-card{background:var(--white); border:1px solid rgba(0,0,0,.08); border-radius:18px; padding:20px; box-shadow: var(--shadow); transform:translateY(10px); opacity:0}
.about-photo img{width:100%; border-radius:16px; box-shadow: var(--shadow)}

.ticks{padding-left:18px}
.ticks li{margin:6px 0}

.site-footer{padding:30px 0; border-top:1px solid rgba(0,0,0,.08); background: color-mix(in oklab, var(--cream) 60%, white)}
.footer-inner{display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap}
.brand.small .brand-mark{width:32px; height:32px}
.newsletter label{font-weight:700}
.newsletter .row{display:flex; gap:8px; margin-top:6px}
.newsletter input{padding:10px 12px; border-radius:12px; border:1px solid rgba(0,0,0,.12); min-width:260px}
.newsletter .note{display:block; color:var(--muted); margin-top:6px}

/* ========== Modal ========== */
.modal{border:none; padding:0; background:transparent}
.modal::backdrop{background: rgba(0,0,0,.3); backdrop-filter: blur(2px)}
.modal-card{background:var(--white); width:min(880px, 92vw); border-radius:18px; border:1px solid rgba(0,0,0,.08); box-shadow: var(--shadow); overflow:hidden}
.modal-card .close{position:absolute; right:18px; top:12px; background:transparent; border:none; font-size:20px; cursor:pointer}
.modal-body{display:grid; grid-template-columns: 1fr 1.1fr; gap:16px; padding:18px}
.modal-body img{width:100%; border-radius:12px; aspect-ratio: 4/5; object-fit:cover}
.qv-info .row{display:flex; gap:10px; margin-top:10px}

/* ========== Reveal animation helper ========== */
.reveal{transition: .6s ease; will-change: transform, opacity}

/* ========== Responsive ========== */
@media (max-width: 980px){
  .hero-inner{grid-template-columns:1fr; padding-bottom:24px}
  .best-grid{grid-template-columns:1fr 1fr}
  .grid{grid-template-columns:1fr 1fr}
  .about-inner{grid-template-columns:1fr}
  .search input{min-width:120px}
}

@media (max-width: 560px){
  .best-grid{grid-template-columns:1fr}
  .grid{grid-template-columns:1fr}
}
